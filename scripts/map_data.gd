extends RefCounted
## Map geometry shared by server and client: wall grid, line of sight (grid DDA
## raycasts), smoke occlusion, circle collision and A* pathfinding.
## The map is point-symmetric (180 degree rotation about the centre) so both
## teams get exactly the same layout.

const Cfg = preload("res://scripts/config.gd")

const T := Cfg.TILE
const W := Cfg.MAP_W
const H := Cfg.MAP_H

## Left half of the map (columns 0..19). The right half is generated by rotating
## this 180 degrees around the map centre.  '#' = wall, '.' = floor.
const LEFT_HALF := [
	"####################",
	"#...................",
	"#...................",
	"#...######.....##...",
	"#...#..........##...",
	"#...#...............",
	"#..........######...",
	"#..##...............",
	"#...........#.......",
	"#......##...#.......",
	"#......##...#......#",
	"#..................#",
	"#......##...........",
	"#......##.....###...",
	"#...................",
	"#..##..........#....",
	"#..............#....",
	"#...#....###...#....",
	"#...#...............",
	"#...######..........",
	"#...................",
	"####################",
]

var grid := PackedByteArray()
var astar := AStarGrid2D.new()


func _init() -> void:
	grid.resize(W * H)
	grid.fill(0)
	for y in H:
		var row: String = LEFT_HALF[y]
		for x in W / 2:
			if row[x] == "#":
				grid[y * W + x] = 1
				grid[(H - 1 - y) * W + (W - 1 - x)] = 1
	astar.region = Rect2i(0, 0, W, H)
	astar.cell_size = Vector2(T, T)
	astar.offset = Vector2(T * 0.5, T * 0.5)
	astar.diagonal_mode = AStarGrid2D.DIAGONAL_MODE_ONLY_IF_NO_OBSTACLES
	astar.default_compute_heuristic = AStarGrid2D.HEURISTIC_OCTILE
	astar.default_estimate_heuristic = AStarGrid2D.HEURISTIC_OCTILE
	astar.update()
	for y in H:
		for x in W:
			if grid[y * W + x] == 1:
				astar.set_point_solid(Vector2i(x, y), true)


func is_wall_tile(x: int, y: int) -> bool:
	if x < 0 or y < 0 or x >= W or y >= H:
		return true
	return grid[y * W + x] == 1


func is_wall_at(p: Vector2) -> bool:
	return is_wall_tile(floori(p.x / T), floori(p.y / T))


func spawn_position(team: int, idx: int) -> Vector2:
	var ys := [7.5, 11.0, 14.5]
	var p := Vector2(2.5 * T, ys[idx] * T)
	if team == 1:
		p = Cfg.WORLD_SIZE - p
	return p


func spawn_facing(team: int) -> float:
	return 0.0 if team == 0 else PI


## Tactical callout waypoints (Team 0 coordinates).
## For Team 1, positions are inverted (Cfg.WORLD_SIZE - p) so callouts match the screen.
const CALLOUT_POSITIONS := {
	"base": Vector2(3.5 * Cfg.TILE, 11.0 * Cfg.TILE),
	"yard": Vector2(9.0 * Cfg.TILE, 11.0 * Cfg.TILE),
	"choke": Vector2(13.5 * Cfg.TILE, 5.5 * Cfg.TILE),
	"flank": Vector2(13.5 * Cfg.TILE, 16.5 * Cfg.TILE),
	"pillar": Vector2(16.5 * Cfg.TILE, 9.0 * Cfg.TILE),
	"mid": Vector2(20.0 * Cfg.TILE, 9.0 * Cfg.TILE),
	"north": Vector2(20.0 * Cfg.TILE, 2.0 * Cfg.TILE),
	"south": Vector2(20.0 * Cfg.TILE, 19.5 * Cfg.TILE),
	"enemy": Vector2(36.5 * Cfg.TILE, 11.0 * Cfg.TILE),
}


func callout_position(callout_id: String, team: int) -> Vector2:
	if not CALLOUT_POSITIONS.has(callout_id):
		return Vector2.ZERO
	var p: Vector2 = CALLOUT_POSITIONS[callout_id]
	if team == 1:
		p = Cfg.WORLD_SIZE - p
	return p


func team_direction_angle(dir_name: String, team: int) -> float:
	var a := 0.0
	match dir_name:
		"north", "up": a = -PI * 0.5
		"south", "down": a = PI * 0.5
		"east", "forward", "front", "ahead", "right": a = 0.0
		"west", "back", "rear", "behind", "left": a = PI
	if team == 1:
		a = wrapf(a + PI, -PI, PI)
	return a


## Distance along a normalised direction until the first wall (capped at max_d).
func raycast(o: Vector2, d: Vector2, max_d: float) -> float:
	var x := floori(o.x / T)
	var y := floori(o.y / T)
	if is_wall_tile(x, y):
		return 0.0
	var step_x := 1 if d.x > 0.0 else -1
	var step_y := 1 if d.y > 0.0 else -1
	var t_max_x := INF
	var t_max_y := INF
	var t_dx := INF
	var t_dy := INF
	if absf(d.x) > 1e-9:
		var nx := float((x + (1 if d.x > 0.0 else 0)) * T)
		t_max_x = (nx - o.x) / d.x
		t_dx = T / absf(d.x)
	if absf(d.y) > 1e-9:
		var ny := float((y + (1 if d.y > 0.0 else 0)) * T)
		t_max_y = (ny - o.y) / d.y
		t_dy = T / absf(d.y)
	var t := 0.0
	while true:
		if t_max_x < t_max_y:
			t = t_max_x
			if t >= max_d:
				return max_d
			x += step_x
			t_max_x += t_dx
		else:
			t = t_max_y
			if t >= max_d:
				return max_d
			y += step_y
			t_max_y += t_dy
		if is_wall_tile(x, y):
			return t
	return max_d


## Clip a ray (origin, unit dir, current length) by smoke clouds.
## smokes: Array of [Vector2 centre, float radius]
static func smoke_clip(o: Vector2, d: Vector2, length: float, smokes: Array) -> float:
	var best := length
	for s in smokes:
		var c: Vector2 = s[0]
		var r: float = s[1]
		var oc := c - o
		var proj := oc.dot(d)
		var h2 := oc.length_squared() - proj * proj
		if h2 >= r * r:
			continue
		var half := sqrt(r * r - h2)
		var t0 := proj - half
		var t1 := proj + half
		var enter := maxf(t0, 0.0)
		if t1 - enter > Cfg.SMOKE_SEE_DEPTH:
			best = minf(best, enter + Cfg.SMOKE_SEE_DEPTH)
	return best


## Visible distance along a ray, considering walls and smoke.
func sight_distance(o: Vector2, d: Vector2, max_d: float, smokes: Array) -> float:
	var dist := raycast(o, d, max_d)
	if not smokes.is_empty():
		dist = smoke_clip(o, d, dist, smokes)
	return dist


func has_los(a: Vector2, b: Vector2, smokes: Array) -> bool:
	var diff := b - a
	var length := diff.length()
	if length < 0.001:
		return true
	var d := diff / length
	return sight_distance(a, d, length, smokes) >= length - 0.5


## Is p inside the vision area of a soldier at `origin` facing `facing`?
## (Range/cone test only, no occlusion.)
static func in_view_shape(origin: Vector2, facing: float, p: Vector2) -> bool:
	var diff := p - origin
	var dist := diff.length()
	if dist <= Cfg.AWARE_RADIUS:
		return true
	if dist > Cfg.VIEW_RANGE:
		return false
	return absf(angle_difference(facing, diff.angle())) <= Cfg.VIEW_CONE * 0.5


func can_see(origin: Vector2, facing: float, p: Vector2, smokes: Array) -> bool:
	return in_view_shape(origin, facing, p) and has_los(origin, p, smokes)


## A circle of radius r can travel in a straight line from a to b.
func clear_walk(a: Vector2, b: Vector2, r: float) -> bool:
	var diff := b - a
	var length := diff.length()
	if length < 0.001:
		return true
	var d := diff / length
	var n := Vector2(-d.y, d.x) * (r + 1.0)
	for off in [Vector2.ZERO, n, -n]:
		if raycast(a + off, d, length) < length:
			return false
	return true


## Push a circle out of any overlapping wall tiles.
func resolve_circle(p: Vector2, r: float) -> Vector2:
	for _iter in 3:
		var moved := false
		var x0 := floori((p.x - r) / T)
		var x1 := floori((p.x + r) / T)
		var y0 := floori((p.y - r) / T)
		var y1 := floori((p.y + r) / T)
		for ty in range(y0, y1 + 1):
			for tx in range(x0, x1 + 1):
				if not is_wall_tile(tx, ty):
					continue
				var rmin := Vector2(tx * T, ty * T)
				var closest := Vector2(clampf(p.x, rmin.x, rmin.x + T), clampf(p.y, rmin.y, rmin.y + T))
				var diff := p - closest
				var dist := diff.length()
				if dist < r:
					if dist > 0.0001:
						p += diff / dist * (r - dist)
					else:
						var cdir := p - (rmin + Vector2(T, T) * 0.5)
						if cdir.length() < 0.001:
							cdir = Vector2.RIGHT
						p += cdir.normalized() * r
					moved = true
		if not moved:
			break
	p.x = clampf(p.x, r, Cfg.WORLD_SIZE.x - r)
	p.y = clampf(p.y, r, Cfg.WORLD_SIZE.y - r)
	return p


func _nearest_open_tile(t: Vector2i) -> Vector2i:
	if not is_wall_tile(t.x, t.y):
		return t
	for radius in range(1, 6):
		var best := Vector2i(-1, -1)
		var best_d := INF
		for dy in range(-radius, radius + 1):
			for dx in range(-radius, radius + 1):
				var c := t + Vector2i(dx, dy)
				if not is_wall_tile(c.x, c.y):
					var dd := Vector2(dx, dy).length()
					if dd < best_d:
						best_d = dd
						best = c
		if best.x >= 0:
			return best
	return t


## Returns waypoints (pixel coords) from `from` to `to` (excluding the start).
func find_path(from: Vector2, to: Vector2) -> PackedVector2Array:
	to.x = clampf(to.x, 1.0, Cfg.WORLD_SIZE.x - 1.0)
	to.y = clampf(to.y, 1.0, Cfg.WORLD_SIZE.y - 1.0)
	var ft := _nearest_open_tile(Vector2i(floori(from.x / T), floori(from.y / T)))
	var tt_raw := Vector2i(floori(to.x / T), floori(to.y / T))
	var tt := _nearest_open_tile(tt_raw)
	var pts := astar.get_point_path(ft, tt, true)
	var out := PackedVector2Array()
	for i in range(1, pts.size()):
		out.append(pts[i])
	# Final waypoint: the exact click location if it is on open floor.
	if tt == tt_raw and not pts.is_empty() and Vector2i(floori(pts[pts.size() - 1].x / T), floori(pts[pts.size() - 1].y / T)) == tt:
		var exact := resolve_circle(to, Cfg.SOLDIER_RADIUS)
		if out.is_empty():
			out.append(exact)
		else:
			out[out.size() - 1] = exact
	return out


func debug_print() -> void:
	for y in H:
		var s := ""
		for x in W:
			s += "#" if grid[y * W + x] == 1 else "."
		print(s)
